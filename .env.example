# RailGlance Environment Variables Example
# Copy this file to .env (or .env.local) and adjust values.

# Optional: Cloudflare R2 / Custom CDN Static Dataset Base URL
# Example for R2.dev public access: https://pub-xxxxxxxx.r2.dev
# Example for Custom Domain: https://data.railglance.example
VITE_RAILWAY_DATA_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Required by the R2 deployment command. Comma-separate preview/production origins.
R2_CORS_ALLOWED_ORIGINS=https://railglance.example,https://railglance-preview.example

# Error tracking. The DSN is intentionally a browser-visible project endpoint, not a secret.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_RELEASE=railglance@0.1.0
VITE_APP_ENVIRONMENT=prototype

# Build-time source map upload (CI/build environment only; never VITE_-prefixed).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Diagnostic telemetry is opt-in because it contains precise GPS history.
# Use errors-only for normal production builds, diagnostic only for consenting testers.
VITE_TELEMETRY_MODE=errors-only
VITE_TELEMETRY_ENDPOINT=https://telemetry.railglance.example
# Short-lived/private-distribution upload token; do not treat a browser token as a permanent secret.
VITE_TELEMETRY_UPLOAD_TOKEN=
VITE_TELEMETRY_BATCH_SIZE=100
VITE_TELEMETRY_FLUSH_INTERVAL_MS=20000
VITE_TELEMETRY_MAX_STORED_EVENTS=3600
VITE_TELEMETRY_MAX_AGE_MS=3600000
VITE_RAILWAY_DATASET_VERSION=
VITE_EVEN_SDK_VERSION=0.0.12
